# /etc/systemd/system/loki.service
[Unit]
Description=Loki log service
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/bin/loki -config.file=/home/ubuntu/loki-config/loki.yaml -log.level=info
WorkingDirectory=/mnt/volume_nyc3_01/vector
Restart=on-failure

[Install]
WantedBy=multi-user.target
